#!/usr/bin/env nu

const costs = [0 394 992 1732 2788 3783 5632 8139 10452 13298 18478 23213 29038 39494 49107 66010 81766 101146 134598 154304 205012 270839 311541 411229 506475 665201 767723 1007959 1240496 1526516 1995717 2311042 3020994 3935195 4572136 5624478 7325850 9011590 11085051 13635408 17704143 20630781 26786470 32948197 40527121 52742840 61315353 79338129 97648282 120108270]
const workers = [30 38 50 64 80 96 114 134 154 174 196 218 240 264 288 314 340 366 394 420 448 478 506 536 566 598 628 660 692 724 758 790 824 860 894 928 964 1000 1036 1072 1110 1146 1184 1222 1260 1300 1338 1378 1418 1458]

export def cost-per-worker-per-level [] {
  let workers_diff = $workers | zip ($workers | skip 1) | each {|i| $i.1 - $i.0}
  $costs | skip 1 | zip $workers_diff | each {|i| print $"($i)"; $i.0 / $i.1 } | prepend [0 0]
}

export def upgrade-duration [--mult: float = 1.0] {
  ($costs | skip 1) | zip $workers | each {|i| ($i.0 / ($i.1 * $mult)) | into int | into duration --unit hr  } | prepend [0 0]
}
